{# Fiche d'un commandant (variable `commandant`, Data::getCommandant), partagée par /compte et /commandant/{numero}.
   `pageCompte` (variable posée par la page avant l'include) : boutons de « Mon compte » au lieu de ceux de la fiche publique. #}
<section>
    <figure>
        <img src="{{ commandant.avatar }}" alt="" width="200" height="200">
        <figcaption class="race{{ commandant.race }}">{{ commandant.raceNom }}</figcaption>
    </figure>
    <div>
        <h2 class="race{{ commandant.race }}">{{ commandant.nom }} ({{ commandant.numero }})</h2>
        <dl>
            {% if commandant.email %}
                <div><dt>E-mail</dt><dd>{{ commandant.email }}</dd></div>
            {% endif %}
            <div><dt>Arrivé au tour</dt><dd>{{ commandant.tourArrivee }}</dd></div>
            {% if commandant.profil %}
                {% for st in commandant.profil.stats %}
                    <div><dt>{{ st.label }} (tour {{ commandant.profil.tour }})</dt><dd>{{ st.valeur }}</dd></div>
                {% endfor %}
                <div><dt>Messages sur le forum</dt><dd>{{ commandant.profil.messages }}</dd></div>
            {% endif %}
        </dl>
        <nav class="button-group" aria-label="Actions">
            {% if pageCompte %}
                <a class="button button--primary" href="/play/console">Passer ses ordres</a>
                <a class="button button--secondary" href="/statistiques?page=/statistiques/detail%3Fnums%3D{{ commandant.numero }}">Ma progression</a>
                <form method="post" action="/deconnexion">
                    <input type="hidden" name="csrf" value="{{ csrf }}">
                    <button class="button button--secondary" type="submit">Se déconnecter</button>
                </form>
            {% else %}
                <a class="button button--secondary" href="/statistiques?page=/statistiques/detail%3Fnums%3D{{ commandant.numero }}">Sa progression</a>
                {% if user and user.numero == commandant.numero %}
                    <a class="button button--secondary" href="/compte">Mon compte</a>
                {% endif %}
            {% endif %}
        </nav>
    </div>
</section>
