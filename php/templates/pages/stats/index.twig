{% extends "layout.twig" %}

{% block content %}
    <main id="stats">
        <aside class="card" aria-label="Choix des statistiques">
            {% for groupe in groupes %}
                <h2>{{ groupe.titre }}</h2>
                <ul class="unstyled-list">
                    {% for lien in groupe.liens %}
                        <li><a href="{{ lien.url }}" target="stats-detail">{{ lien.label }}</a></li>
                    {% endfor %}
                </ul>
            {% endfor %}
            <h2>Archives</h2>
            <ul class="stats-archives unstyled-list">
                {% for a in archives %}
                    <li><a href="{{ a.url }}" target="_blank" rel="noopener">{{ a.label }}</a></li>
                {% endfor %}
            </ul>
        </aside>
        <iframe class="page-frame" name="stats-detail" src="/statistiques/general" title="Statistiques"></iframe>
        <script>
            // Lien actif : le premier (classement général) au chargement, puis celui qu'on clique
            (function () {
                var liens = document.querySelectorAll('#stats > aside a[target="stats-detail"]');
                liens[0].setAttribute('aria-current', 'page');
                liens.forEach(function (a) {
                    a.addEventListener('click', function () {
                        liens.forEach(function (l) { l.removeAttribute('aria-current'); });
                        a.setAttribute('aria-current', 'page');
                    });
                });
            })();
        </script>
    </main>
{% endblock %}
