{# Gabarit des pages affichées dans une iframe du site : pas d'en-tête, de menu ni de pied de page. #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap">
    <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/assets/css/v2/sheril.css">
    <title>{{ title }}</title>
    {% if parent %}
        {# Ouverte hors de son iframe (lien direct) : on recharge la page parente avec cette page dans l'iframe #}
        <script>
            if (window.top === window.self) {
                location.replace('{{ parent }}?page=' + encodeURIComponent(location.pathname + location.search));
            }
        </script>
    {% endif %}
</head>
<body class="embed">
    {% block content %}
    {% endblock %}
</body>
</html>
