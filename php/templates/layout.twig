<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Sheril, jeu de stratégie 4X spatial au tour par tour : dirigez un peuple mutant et conquérez la galaxie.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap">
    <link rel="stylesheet" href="/assets/css/v2/sheril.css">
    <title>{{ title }}</title>
</head>
<body>

<header>
    <section>
        <a class="logo" href="/" aria-label="Sheril, retour à l'accueil">
            <svg class="icon icon--large" aria-hidden="true"><use href="#i-logo"/></svg>
            <span>Sheril</span>
        </a>
        <code>
            Partie <strong>Corylis</strong> ·
            Dernier tour
            <strong>1</strong>
            <time datetime="2026-09-16">16/09/2026</time>
        </code>

        <div>
            {% if user %}
                <a class="button button--secondary" href="/rapport">
                    <svg class="icon icon--small" aria-hidden="true"><use href="#i-download"/></svg>
                    Télécharger le rapport
                </a>
                <a class="button button--primary" href="/play/console">
                    <svg class="icon icon--small icon--on-primary" aria-hidden="true"><use href="#i-send"/></svg>
                    Passer ses ordres
                </a>
            {% else %}
                <a class="button button--secondary" href="https://discord.gg/bdUtYSqrnK">Rejoindre le Discord</a>
                <a class="button button--primary" href="/connexion">Se connecter</a>
            {% endif %}
        </div>
    </section>

    <nav aria-label="Navigation principale">
        <a href="/" aria-current="page">Accueil</a>
        <a href="/lore/presentation">Présentation</a>
        <a href="/rule/sommaire">Règles du jeu</a>
        <a href="/play">Jouer</a>
        <a href="/forum">Forum</a>
        <a href="/statistiques">Statistiques</a>
        <a href="/archives">Archives</a>
        {% if user %}
            {# Commandant connecté, à droite du menu, contre l'avatar #}
            <a href="/compte" class="race{{ user.race }}">{{ user.nom }} ({{ user.numero }})</a>
        {% endif %}
    </nav>

    {% if user %}
        {# Avatar du commandant, dans le coin haut droit, à cheval sur les deux bandes de l'en-tête #}
        <a href="/compte" title="Mon compte · {{ user.nom }} ({{ user.numero }})">
            <img src="{{ user.avatar }}" alt="Mon compte ({{ user.nom }})" width="200" height="200">
        </a>
    {% endif %}
</header>

    {% block content %}
    {% endblock %}

<footer>

</footer>

<!-- Sprite d'icônes  -->
<svg xmlns="http://www.w3.org/2000/svg" style="position:absolute;width:0;height:0" aria-hidden="true" focusable="false">
    <symbol id="i-logo" viewBox="0 0 28 28"><circle cx="14" cy="14" r="11"/><circle cx="14" cy="14" r="5"/><path d="M14 1v5M14 22v5M1 14h5M22 14h5"/></symbol>
    <symbol id="i-chart" viewBox="0 0 24 24"><path d="M4 20V10M10 20V4M16 20v-8M22 20H2"/></symbol>
    <symbol id="i-download" viewBox="0 0 24 24"><path d="M12 3v12M7 10l5 5 5-5M4 21h16"/></symbol>
    <symbol id="i-send" viewBox="0 0 24 24"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4z"/></symbol>
    <symbol id="i-image" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="M21 15l-5-5L5 21"/></symbol>
    <symbol id="i-list" viewBox="0 0 24 24"><path d="M9 6h12M9 12h12M9 18h12M4 6h.01M4 12h.01M4 18h.01"/></symbol>
    <symbol id="i-user-plus" viewBox="0 0 24 24"><circle cx="9" cy="8" r="4"/><path d="M2 21v-1a6 6 0 0 1 12 0v1M19 8v6M16 11h6"/></symbol>
    <symbol id="i-tool" viewBox="0 0 24 24"><path d="M14.7 6.3a4 4 0 0 0 5 5L22 14l-8 8-2.3-2.3a4 4 0 0 0-5-5L2 10l8-8z"/></symbol>
    <symbol id="i-warning" viewBox="0 0 24 24"><path d="M12 3l10 18H2z"/><path d="M12 10v5M12 18v.01"/></symbol>
</svg>

</body>
</html>